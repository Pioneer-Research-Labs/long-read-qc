{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "unique": true,
        "errorMessage": "Sample name must be provided and must be unique",
        "meta": ["id"]
      },
      "construct": {
        "type": "string"
      },
      "catalog": {
        "type": "string",
        "format": "file-path",
        "exists": true,
        "errorMessage": "Catalog CSV file must be provided and must exist"
      },
      "file": {
        "type": "string",
        "format": "file-path",
        "exists": true,
        "unique": true,
        "pattern": "^.*(\\.fastq\\.gz|\\.fq\\.gz|\\.fastq|\\.fq)$",
        "errorMessage": "FastQ file for reads must be provided and must have extension '.fq.gz', '.fastq.gz', '.fq', or '.fastq'"
      }
    },
    "required": ["id", "construct", "catalog", "file"]
  }
}
