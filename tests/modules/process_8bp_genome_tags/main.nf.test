nextflow_process {

    name "Test Process process_8bp_genome_tags"
    script "modules/process_8bp_genome_tags/main.nf"
    process "process_8bp_genome_tags"

    test("Should process 8bp genome tags and generate sample sheet") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
               input[0] = Channel.fromList([ tuple( [id:'test_sample'],
                file('${projectDir}/test_data/test_extracted_genome_tags.tsv'),
                file('${projectDir}/test_data/Tesseract_Barcode_Tracking_Grid.csv'),
                file('s3://pioneer-scratch/dummy/dummy_seqs/test.fastq.gz'),
                file('${projectDir}/test_data/c.00432.dna') )])
                """
            }
        }

        then {
            def stable_name_genome_tags = getAllFilesFromDir("$outputDir/test_sample" , relative: true, includeDir: false )

            assert process.success
            assert path("$outputDir/test_sample/primary_data/test_sample_sample_sheet.csv").readLines().size() == 11
            assert snapshot(stable_name_genome_tags).match("Should process 8bp genome tags and generate sample sheet")
        }

    }

}
