nextflow_process {

    name "Test Process map_inserts"
    script "modules/map_inserts/main.nf"
    process "map_inserts"

    test("Should map inserts") {

        when {
            params {
                outdir =  "$outputDir"
            }
            process {
                """
                input[0] = Channel.fromList([ tuple( [id:'Gateway_EmptyBarcodedLib1_20241217',
                genome:'Halomonas_elongata_DSM_2581_GCF_000196875.2'],
                file('${projectDir}/test_data/Gateway_EmptyBarcodedLib1_20241217/inserts.fasta'),
                file("s3://pioneer-data/pioneer-genomes/Halomonas_elongata_DSM_2581_GCF_000196875.2/*_genomic.fna".toString()))])
                """
            }
        }

        then {
            def stable_name_mapped_inserts = getAllFilesFromDir("$outputDir/Gateway_EmptyBarcodedLib1_20241217/primary_data" , relative: true, includeDir: false )

            assert process.success
            assert snapshot(stable_name_mapped_inserts).match("Should map inserts")
        }

    }

}
