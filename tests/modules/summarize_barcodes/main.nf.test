nextflow_process {

    name "Test Process summarize_barcodes"
    script "modules/summarize_barcodes/main.nf"
    process "summarize_barcodes"

    test("Should generate barcode summaries and plots") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = file('${projectDir}/test_data/barcode_map.tsv')
                """
            }
        }

        then {
            def stable_name_summaries = getAllFilesFromDir("$outputDir/summary_and_plots" , relative: true, includeDir: false )
            assert process.success
            assert process.out.size() == 1
            assert snapshot(stable_name_summaries).match("Should generate barcode summaries and plots")
        }

    }

}
