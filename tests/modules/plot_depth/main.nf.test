nextflow_process {

    name "Test Process plot_depth"
    script "modules/plot_depth/main.nf"
    process "plot_depth"

    test("Should plot sequencing depth"){

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = Channel.fromList([ tuple( [id:'Gateway_EmptyBarcodedLib1_20241217',
                genome:'H_elongata'],
                file('${projectDir}/test_data/Gateway_EmptyBarcodedLib1_20241217/mapped_inserts.bam'),
                file('${projectDir}/test_data/Gateway_EmptyBarcodedLib1_20241217/mapped_inserts.bam.bai'),
                file('${projectDir}/test_data/Gateway_EmptyBarcodedLib1_20241217/mapped_inserts_stats.tsv')
                )])
                """
            }
        }

        then {
            def stable_name_depth = getAllFilesFromDir("$outputDir/Gateway_EmptyBarcodedLib1_20241217/summary_and_plots" , relative: true, includeDir: false )

            assert process.success
            assert snapshot(stable_name_depth).match("Should plot sequencing depth")
        }

    }

}
