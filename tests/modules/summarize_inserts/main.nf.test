nextflow_process {

    name "Test Process summarize_inserts"
    script "modules/summarize_inserts/main.nf"
    process "summarize_inserts"

    test("Should generate barplot") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = file('${projectDir}/test_data/insert_map.tsv')
                """
            }
        }

        then {
            def stable_name_bar_plot = getAllFilesFromDir("$outputDir/summary_and_plots" , relative: true, includeDir: false )
            assert process.success
            assert process.out.size() == 1
            assert snapshot(stable_name_bar_plot).match("Should generate barplot")
        }

    }

}
