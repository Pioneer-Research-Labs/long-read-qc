nextflow_process {

    name "Test Process map_genome"
    script "modules/map_genome/main.nf"
    process "map_genome"

    test("Should map sequences to genome") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = Channel.fromList([ tuple( [id:'Gateway_EmptyBarcodedLib1_20241217',
                genome:'Halomonas_elongata_DSM_2581_GCF_000196875.2'],
                file('${projectDir}/test_data/Gateway_EmptyBarcodedLib1_20241217/5HKJT6_1_sample_1.fastq.gz'),
                file('${projectDir}/test_data/Gateway_EmptyBarcodedLib1_20241217/c.00323.dna'),
                file("s3://pioneer-data/pioneer-genomes/Halomonas_elongata_DSM_2581_GCF_000196875.2/*_genomic.fna".toString()))])
                """
            }
        }

        then {
            def stable_name_genome_map = getAllFilesFromDir("$outputDir/Gateway_EmptyBarcodedLib1_20241217/map_genome_analysis" , relative: true, includeDir: false )

            assert process.success
            assert snapshot(stable_name_genome_map).match("Should map sequences to genome")
        }

    }

}
