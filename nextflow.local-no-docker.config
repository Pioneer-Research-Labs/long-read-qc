// Local execution configuration without Docker.
// Use with: nextflow run . -c nextflow.local-no-docker.config ...
// This disables Docker so all processes run directly on the host (local executor),
// rather than inside the Docker container image.
//
// IMPORTANT: When using this configuration, all bioinformatics tools that are
// normally provided by the Docker image (see the Dockerfile) must be
// pre-installed on the host system and available on the PATH.
docker {
    enabled = false
}
